# ------------------------------------------------------------------
# Database
# Local dev (docker compose up): matches docker-compose.yml
# Production: use your Neon pooled connection string for DATABASE_URL
# and the direct/unpooled string for DATABASE_URL_UNPOOLED (prisma CLI/migrations)
# ------------------------------------------------------------------
DATABASE_URL="postgresql://ocpanelist:ocpanelist@localhost:5433/ocpanelist?schema=public"
DATABASE_URL_UNPOOLED="postgresql://ocpanelist:ocpanelist@localhost:5433/ocpanelist?schema=public"

# ------------------------------------------------------------------
# Better Auth (https://better-auth.com) — MUST be at least 32 characters
# Generate one: openssl rand -hex 32
# BETTER_AUTH_URL is the base URL of the app (used for OAuth callbacks).
# On Vercel set it to the production origin — or leave it out: a missing
# or localhost value there is replaced by the deployment URL automatically.
# ------------------------------------------------------------------
BETTER_AUTH_SECRET="change-me-to-a-random-string-at-least-32-chars-long"
BETTER_AUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------
# Google OAuth (sign-in) — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
# Local/dev without credentials: seed an account session instead (see README)
# ------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ------------------------------------------------------------------
# PostHog (https://posthog.com) — leave empty to no-op locally
# Project token from posthog.com/project/settings; both env names work
# (NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN is what the PostHog docs/wizard write)
# ------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
NEXT_PUBLIC_POSTHOG_UI_HOST="https://us.posthog.com"

# ------------------------------------------------------------------
# Vercel — populated automatically on Vercel deployments
# (Analytics/Speed Insights need no env vars; enable in the dashboard)
# ------------------------------------------------------------------

# ------------------------------------------------------------------
# Public site URL — base for canonical URLs, Open Graph, sitemap and
# robots.txt. Set to the production domain on Vercel; a missing or
# localhost value there falls back to the deployment origin.
# ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
