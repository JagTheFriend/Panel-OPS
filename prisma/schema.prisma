generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoomRole {
  ADMIN
  USER
}

enum CandidateStatus {
  WAITING
  IN_INTERVIEW
  DONE
}

/// A signed-in person (Google account, managed by better-auth).
model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions         Session[]
  accounts         Account[]
  roomMemberships RoomMembership[]
  createdRooms     Room[]           @relation("RoomCreator")
  createdPanels    Panel[]          @relation("PanelCreator")
  panelMemberships PanelMembership[]
  addedCandidates  Candidate[]      @relation("CandidateAdder")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  providerId            String
  accountId             String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// A shared space panels live in. Access is granted by knowing a PIN.
model Room {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  adminPin    String
  normalPin   String
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User              @relation("RoomCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members   RoomMembership[]
  panels    Panel[]

  @@index([createdById])
}

/// A user's standing in a room — role comes from which PIN they entered.
model RoomMembership {
  id       String   @id @default(cuid())
  roomId   String
  userId   String
  role     RoomRole @default(USER)
  joinedAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
}

/// A domain panel inside a room. Room admins create/edit/delete these.
model Panel {
  id          String   @id @default(cuid())
  roomId      String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  room       Room               @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdBy  User               @relation("PanelCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members    PanelMembership[]
  candidates Candidate[]

  @@unique([roomId, name])
  @@index([roomId])
  @@index([createdById])
}

/// A user staffing a panel. Admins auto-join the panels they create.
model PanelMembership {
  id       String   @id @default(cuid())
  panelId  String
  userId   String
  joinedAt DateTime @default(now())

  panel Panel @relation(fields: [panelId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([panelId, userId])
  @@index([userId])
}

/// A participant waiting for / in / finished an interview at a panel.
model Candidate {
  id          String          @id @default(cuid())
  panelId     String
  rollNo      String
  name        String?
  status      CandidateStatus @default(WAITING)
  position    Int             @default(0)
  joinedAt    DateTime        @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  addedById   String?

  panel   Panel @relation(fields: [panelId], references: [id], onDelete: Cascade)
  addedBy User? @relation("CandidateAdder", fields: [addedById], references: [id], onDelete: SetNull)

  @@unique([panelId, rollNo])
  @@index([panelId, status, position])
  @@index([addedById])
}
